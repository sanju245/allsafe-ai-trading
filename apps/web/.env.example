# Copy to apps/web/.env.local and fill in locally. NEVER commit the real file.

# Base URL of the FastAPI backend. Read on the SERVER only (no NEXT_PUBLIC_ prefix),
# so it is not shipped to the browser.
API_BASE_URL=http://127.0.0.1:8000

# --- Reserved for later phases (leave empty for now) ---
# Public Supabase values are safe for the browser; the service-role key is NOT
# and must never be placed in any file under apps/web.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
