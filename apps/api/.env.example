# Copy to apps/api/.env and fill in locally. NEVER commit the real .env file.
# Server-side only: these values must never be exposed to the browser.

# "development" or "production"
APP_ENV=development

# Comma-separated list of browser origins allowed to call this API (CORS).
CORS_ORIGINS=http://localhost:3000

# --- Reserved for later phases (leave empty for now) ---
# Supabase project URL and server-side service key (Phase 5).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Secret used to verify Supabase JWTs sent by the frontend (Phase 5).
SUPABASE_JWT_SECRET=
# Market-data provider credentials (Phase 2, provider not chosen yet).
MARKET_DATA_API_KEY=
