# Copy to apps/api/.env and fill in locally. NEVER commit the real .env file.
# Server-side only: these values must never be exposed to the browser.

# "development" or "production"
APP_ENV=development

# Comma-separated list of browser origins allowed to call this API (CORS).
CORS_ORIGINS=https://allsafe-ai-trading.vercel.app,http://localhost:3000

# --- Optional Supabase account controls ---
# Project URL stays server-side. Legacy HS256 projects need the JWT secret;
# ES256 and RS256 tokens use the public Supabase JWKS endpoint.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Server-only Auth Admin credential. Never add this to a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=

# Required for public account requests and approval/decline notifications.
# Authorize the gmail.send scope for this Gmail account and keep OAuth secrets
# on the API service only. Render Free supports these HTTPS requests.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_EMAIL=sanjay200123@gmail.com
# Add this origin's /set-password route to Supabase Auth redirect URLs.
PUBLIC_SITE_URL=https://allsafe-ai-trading.vercel.app
ACCOUNT_REQUEST_LIMIT_PER_HOUR=5

# --- Telegram chart notifications (opt-in) ---
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_USERNAME=
# Set this on the delivery worker only, not on the web service or frontend.
TELEGRAM_BOT_TOKEN=

# --- Upstox read-only market data ---
# Shared server-side Analytics token supports historical charts and (when enabled) the live feed.
# Never add this value to Vercel or any NEXT_PUBLIC_* variable.
UPSTOX_ACCESS_TOKEN=
UPSTOX_LIVE_STREAM_ENABLED=false

# --- Groww Live Market-Data Streaming ---
# Disabled by default. Set to true only when valid Groww credentials are configured.
LIVE_STREAM_ENABLED=false
MARKET_DATA_PROVIDER=groww

# Select ONE explicit authentication mode: "access_token", "totp", or "api_key_secret"
# The server will NEVER silently fall back between modes if the configured mode fails.
GROWW_AUTH_MODE=
GROWW_ACCESS_TOKEN=
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_TOTP_SECRET=

LIVE_STALE_SECONDS=60
LIVE_MAX_FUTURE_SKEW_SECONDS=5
LIVE_CANDLE_BUFFER_SIZE=500
LIVE_WARMUP_LOOKBACK_DAYS=5
